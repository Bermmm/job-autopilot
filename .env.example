# Copy to .env and fill in. .env is gitignored and must stay that way —
# the pre-commit hook will block it if you try.
#
#   cp .env.example .env

# Needed when config.yaml sets llm.provider: anthropic
ANTHROPIC_API_KEY=

# Needed when config.yaml sets llm.provider: openai
OPENAI_API_KEY=

# Optional base URL overrides, for a proxy or a local gateway.
# ANTHROPIC_BASE_URL=
# OPENAI_BASE_URL=

# debug | info | warn | error
LOG_LEVEL=info
